{
  "name": "interview-workbench",
  "version": "0.1.0",
  "description": "本地优先的实时面试转录与 AI 追问工作台",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowshadow/interview-workbench.git"
  },
  "homepage": "https://github.com/snowshadow/interview-workbench#readme",
  "bugs": {
    "url": "https://github.com/snowshadow/interview-workbench/issues"
  },
  "keywords": [
    "interview",
    "speech-to-text",
    "llm",
    "local-first",
    "mcp",
    "agent-skills"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "mcp": "node mcp/server.mjs",
    "skills:install:codex": "node scripts/install-skills.mjs codex",
    "check": "node scripts/check.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "node --test test/*.test.js",
    "release:check": "npm run check && npm test && npm run build && npm run check:package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^9.0.3",
    "tailwindcss": "^4.3.0",
    "vite": "^8.1.3",
    "word-extractor": "^1.0.4",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "body-parser@1": "^1.20.6",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.1.0"
  }
}
